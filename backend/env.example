# App Settings
PROJECT_NAME="SelmApp"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security
SECRET_KEY="your-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# CORS
ALLOWED_HOSTS=["http://localhost:3000", "http://localhost:8080", "https://yourdomain.com"]

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/selmapp"
REDIS_URL="redis://localhost:6379"

# Database pool sizing (PER PROCESS). Keep these small on managed Postgres.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_SYNC_POOL_SIZE=1
DB_SYNC_MAX_OVERFLOW=0

# Gunicorn (production)
WEB_CONCURRENCY=1

# OAuth2 Settings
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
FACEBOOK_CLIENT_ID="your-facebook-client-id"
FACEBOOK_CLIENT_SECRET="your-facebook-client-secret"
OAUTH_REDIRECT_URI="http://localhost:8000/api/v1/auth/oauth/callback"

# ────────────────────────────────────────────────────────────────────
# AI Services — required for the app to produce real lessons.
# Minimum for full functionality:
#   - GOOGLE_GEMINI_API_KEY  (content generation)
#   - ELEVENLABS_API_KEY     (natural voice TTS — see block below)
#   - SPEECHACE_API_KEY      (pronunciation, stress, fluency, intonation)
# ────────────────────────────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_CLOUD_API_KEY="your-google-cloud-api-key"
GEMINI_MODEL="gemini-2.5-flash"
# Model tiers — see app/core/config.py for full explanation.
# FAST    = quick interactive feedback (grammar answer checks).
# CONTENT = everything the learner reads/hears (reading passages,
#           listening dialogues, vocab, conversation, lessons).
# REASON  = scoring + analysis (writing/speaking assessment, level
#           determination, learner profile).
GEMINI_TEXT_MODEL_FAST="gemini-2.5-flash-lite"
GEMINI_TEXT_MODEL_CONTENT="gemini-2.5-pro"
GEMINI_TEXT_MODEL_REASON="gemini-2.5-pro"
# Used only when TTS_PROVIDER=gemini (fallback path).
GEMINI_SPEECH_MODEL="gemini-2.5-flash-preview-tts"
GEMINI_TTS_VOICE="Kore"
SPEAKING_PIPELINE="stt_v2+gemini"
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="global"
ELSA_API_KEY="your-elsa-api-key"

# SpeechAce — pronunciation, syllable stress, fluency and intonation
# scoring. Without this key, /api/v1/ai/analyze_pronunciation returns
# a soft-error and Speaking exercises lose their phoneme-level feedback.
# Get a key at https://www.speechace.com → Dashboard → API.
SPEECHACE_API_KEY="your-speechace-api-key"
# OPENAI_API_KEY removed 2026-05-08 — was unused in code.

# ────────────────────────────────────────────────────────────────────
# OpenAI TTS — PRIMARY voice provider as of 2026-05-13.
# gpt-4o-mini-tts gives more natural English prosody than ElevenLabs
# turbo and supports voice direction via the `instructions` parameter.
# Cost: $0.015/1K chars (cheaper than ElevenLabs).
# Get a key at https://platform.openai.com/api-keys
# ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY="your-openai-api-key"

# ────────────────────────────────────────────────────────────────────
# ElevenLabs TTS — SECONDARY / FALLBACK voice provider.
# Required for high-quality lesson/listening audio. If the key is empty
# or invalid, the backend transparently falls back to Gemini TTS so the
# app keeps working, but quality drops noticeably.
# Get a key at https://elevenlabs.io → Profile → API Keys.
# ────────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
# Optional override. Leave empty to let the service pick:
# Rachel for solo narration, gender-matched pool for multi-speaker.
ELEVENLABS_VOICE_ID=""
# TTS provider: "openai" (default, gpt-4o-mini-tts, most natural),
# "elevenlabs" (eleven_turbo_v2_5), or "gemini" (last-resort fallback).
# Factory cascades automatically if the chosen provider's key is missing.
TTS_PROVIDER="openai"

# File Storage
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=10485760

# Audio/TTS Filesystem Storage
AUDIO_STORAGE_DIR="storage/audio"
AUDIO_BASE_URL="/media/audio"
AUDIO_STORAGE_MODE="filesystem"

# Audio/TTS Settings
TTS_SERVICE="google"
AUDIO_FORMAT="mp3"

# Email (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# RevenueCat — shared secret for POST /api/v1/payments/webhooks/revenuecat.
# Must match the Authorization header configured in the RevenueCat dashboard.
# The endpoint FAILS CLOSED: with this unset it returns 500 and processes
# nothing, rather than accepting unauthenticated purchase events.
REVENUECAT_WEBHOOK_AUTH=""

# Admin seeding — REQUIRED, no defaults. The process will not start without
# them. Do not commit real values.
ADMIN_DEV_PASSWORD=""
ADMIN_OWNER_PASSWORD=""

# Logging
LOG_LEVEL="INFO" 