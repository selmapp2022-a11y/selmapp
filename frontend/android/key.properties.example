# Keystore configuration for Google Play release signing
# Copy this file to key.properties and fill in your values
# DO NOT commit key.properties to version control!

# Path to your keystore file (relative to android/ directory or absolute path)
storeFile=../keystore/selmapp-release.jks

# Keystore password
storePassword=your_keystore_password

# Key alias (the name you gave to the key when creating it)
keyAlias=selmapp

# Key password
keyPassword=your_key_password




